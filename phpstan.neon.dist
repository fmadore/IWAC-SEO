# Analysed against the real Omeka S 4.2.1 application (OMEKA_PATH), not
# stand-ins: tests/phpstan-bootstrap.php registers Omeka's autoloader, so every
# Omeka and Laminas type the module touches is the real one and nothing at the
# application boundary needs ignoring.
#
# There is no baseline: level 6 applies in full. Fix a new finding; do not
# record it. The one ignore below is a known PHPStan limitation, explained.

parameters:
    level: 6

    # Analysis runs on whatever PHP CI's Omeka job uses (production 8.5);
    # pinning the version keeps it reporting against the declared 8.4 floor.
    phpVersion: 80400

    paths:
        - Module.php
        - src
        - tests

    bootstrapFiles:
        - tests/phpstan-bootstrap.php

    excludePaths:
        # Stand-ins for the unit suite, which runs without Omeka; with the
        # real classes loaded they are dead code by construction.
        - tests/Shim/omeka.php

    ignoreErrors:
        # ResourceValueReader is a trait, and PHPStan checks constant usage per
        # *using* class: DATE_TERMS and ABSTRACT_TERMS are reported unused
        # against StructuredData, the one of the four users that does not read
        # them. CitationData, CitationMeta and ZoteroRdf all do — deleting them
        # on this report's say-so would break three classes.
        -
            identifier: classConstant.unused
            path: src/Service/StructuredData.php

    treatPhpDocTypesAsCertain: false

services:
    # Types the Omeka view helpers and controller plugins the module calls by
    # name through Laminas's __call(), from the real helper classes.
    -
        class: IwacSeo\Test\PHPStan\PluginMethodsExtension
        tags:
            - phpstan.broker.methodsClassReflectionExtension
