<?xml version="1.0"?>
<ruleset name="IWAC SEO">
    <description>PSR-12, which is what the codebase already follows.</description>

    <file>Module.php</file>
    <file>src</file>
    <file>tests</file>
    <file>config</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12">
        <!--
            Omeka's config and language files are long data tables; aligned
            values read better than a hard column limit allows, and the same
            goes for the SQL and the documentation blocks that explain the
            archive's field conventions.
        -->
        <exclude name="Generic.Files.LineLength"/>
    </rule>
</ruleset>
