# Normalise line endings to LF in the repository (cross-platform consistency).
* text=auto eol=lf

# Binary assets — never normalise.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.mo   binary

# Exclude development cruft from the release zip built by
# `.github/workflows/release.yml`, from `composer archive`, and from GitHub's
# own source tarballs. What should reach an Omeka installation is the module
# runtime (Module.php, src/, config/, view/, asset/, language/), composer.json
# for its licence and autoload metadata, README, CHANGELOG, LICENSE and
# CITATION.cff — the last so that a copy obtained as a zip, without the
# repository behind it, still carries its own citation metadata.
#
# Verify after changing this, since nothing else will:
#   git archive --prefix=IwacSeo/ HEAD | tar -t
/.gitattributes   export-ignore
/.gitignore       export-ignore
/.editorconfig    export-ignore
/.github          export-ignore
/tests            export-ignore
/phpunit.xml.dist export-ignore
/phpunit.integration.xml.dist export-ignore
/phpstan.neon.dist export-ignore
/phpstan-baseline.neon export-ignore
/phpcs.xml.dist   export-ignore
/ROADMAP.md       export-ignore
/CLAUDE.md        export-ignore
